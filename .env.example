# Supabase — from your project's API settings page
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# New-format publishable key (sb_publishable_...).
# Legacy projects may instead use NEXT_PUBLIC_SUPABASE_ANON_KEY; either works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxx

# Never put a secret/service_role key here. This app does not need one, and
# anything prefixed NEXT_PUBLIC_ is shipped to the browser.
